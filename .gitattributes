# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare text files that may be normalized
*.css             text eol=lf
*.html            text eol=lf
*.java            text eol=lf
*.js              text eol=lf
*.json            text eol=lf
*.md              text eol=lf
*.properties      text eol=lf
*.sql             text eol=lf
*.ts              text eol=lf
*.vue             text eol=lf
*.xml             text eol=lf
*.yml             text eol=lf
*.yaml            text eol=lf

# Declare files that will always have LF line endings on checkout
*.sh              text eol=lf

# Denote all files that are truly binary and should not be modified
*.jar             binary
*.png             binary
*.gif             binary
*.jpg             binary
*.jpeg            binary
*.ico             binary
*.pdf             binary
*.zip             binary
*.gz              binary
